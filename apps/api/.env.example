NODE_ENV=production
API_PORT=4000
APP_URL=https://primocloud.in
DATABASE_URL=postgresql://primocloud:CHANGE_ME@127.0.0.1:5432/primocloud
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=generate-with-openssl-rand-hex-48
APP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
COOKIE_SECURE=auto
UPLOAD_DIR=/var/lib/primocloud/uploads
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@primocloud.in
SMTP_PASS=
SMTP_FROM="PrimoCloud <info@primocloud.in>"
INBOUND_EMAIL_SECRET=
IP_RESERVATION_MINUTES=15
# true = simulate hypervisor calls (staging/demo only)
PROVISION_DRY_RUN=false
